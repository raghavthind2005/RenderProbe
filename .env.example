# Copy to .env and fill in the keys you have (export them, or use `source .env`
# / a dotenv loader of your choice - renderprobe just reads os.environ).
# Every entry is optional; a model whose key is unset is sandboxed into a
# model_error Result, not a crash. See README.md, "Run it against a real model".

# Free-tier credits + a live vision roster - build.nvidia.com (currently the most
# reliable real-VLM path; serves meta/llama-3.2-11b|90b-vision on the serverless API)
NVIDIA_API_KEY=

# Free, no card required - ai.google.dev (requires Generative Language API enabled
# in the Google Cloud project; key must come from aistudio.google.com)
GEMINI_API_KEY=

# Free tier with generous daily limits - console.groq.com
GROQ_API_KEY=

# Free-tier ":free" models - openrouter.ai (50 req/day account-wide without credits)
OPENROUTER_API_KEY=

# Paid
OPENAI_API_KEY=
XAI_API_KEY=
